# Copy to .env (gitignored) - never commit real keys.
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max   (thinking depth; claude-opus-5-5 default is medium)
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=2
# Re-run a request on a fallback model if safety classifiers decline it
ANTHROPIC_REFUSAL_FALLBACK=true
